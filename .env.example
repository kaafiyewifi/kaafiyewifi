APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

########################################
# KAAFIYE — REQUIRED IN EVERY ENVIRONMENT
#
# Leave secrets blank here. Never commit a real or placeholder value:
# a placeholder that looks strong ("SuperStrongPasswordHere") is the one
# most likely to survive into production unchanged.
########################################

# FreeRADIUS database (separate connection, see config/database.php)
RADIUS_DB_HOST=127.0.0.1
RADIUS_DB_PORT=3306
RADIUS_DB_DATABASE=radius
RADIUS_DB_USERNAME=
RADIUS_DB_PASSWORD=

# FreeRADIUS server — the shared secret routers authenticate with
RADIUS_IP=10.9.0.1
RADIUS_PORT=1812
RADIUS_ACCOUNTING_PORT=1813
RADIUS_SECRET=

# WireGuard — routers dial in over this tunnel
WG_ENDPOINT=
WG_PORT=51820
WG_SERVER_ADDRESS=10.9.0.1/32
WG_SERVER_PUBLIC_KEY=
WG_PRIVATE_KEY=

# MikroTik API — the account provisioned onto each router.
# Generate with: php -r 'echo bin2hex(random_bytes(20));'
# Keep it alphanumeric: the value is interpolated into a RouterOS .rsc
# script, where $ and " carry meaning.
MIKROTIK_API_PORT=8728
ROUTER_API_USER=kaafiye
ROUTER_API_PASS=

# Hotspot portal assets (generated per router under public/hotspot-files)
HOTSPOT_BASE_URL=

SNMP_COMMUNITY=
ROUTER_TIMEZONE=Africa/Mogadishu
